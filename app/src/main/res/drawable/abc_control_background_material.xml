<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 4.4(API 19) 版本：系统不支持 <ripple>（API 21 引入），
  用 selector 模拟「按下时高亮」的等效效果（原 ripple 带 20dip 圆角，此处用圆角 shape）。
  真正的 <ripple> 版本在 res/drawable-v21/ 中，API 21+ 设备仍走原实现。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/androidx_core_ripple_material_light" />
            <corners android:radius="20.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="20.0dip" />
        </shape>
    </item>
</selector>
