<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 4.4(API 19) 版本：系统不支持 <ripple>（API 21 引入），
  用 selector 模拟「按下时高亮」的等效效果。
  真正的 <ripple> 版本在 res/drawable-v21/ 中，API 21+ 设备仍走原实现。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@color/androidx_core_ripple_material_light" />
    <item android:drawable="@android:color/transparent" />
</selector>
